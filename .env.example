# --- Discord ---
# Bot token from https://discord.com/developers/applications (Bot tab).
DISCORD_BOT_TOKEN=
# Right-click each channel in Discord (Developer Mode on) -> Copy Channel ID.
# These can be different channels/servers - the bot just needs to be a member
# of whichever server each channel lives in.
DISCORD_SETTER_EOD_CHANNEL_ID=
DISCORD_WEEKLY_CHECKIN_CHANNEL_ID=

# --- Airtable ---
# Personal Access Token (airtable.com/create/tokens) scoped to read data.records
# on both the EOD Reports base and The Called - Client Success base. Add
# data.records:write too if NEW_MEMBER_ONBOARDING_ENABLED is turned on below -
# that's the only automation that writes (the matched client's Discord ID).
AIRTABLE_PAT=

# Base IDs already default to the correct bases in code - only set these if the
# bases ever get recreated/renamed.
# AIRTABLE_EOD_BASE_ID=appO76t48mwkC3j80
# AIRTABLE_CLIENT_SUCCESS_BASE_ID=appkSTSqkeXGHt6pY

# --- Optional ---
# How often (ms) to poll Airtable for new records. Default 60000 (1 minute).
# POLL_INTERVAL_MS=60000
# Where to persist the "last seen record" watermark. Default data/state.json.
# STATE_FILE_PATH=data/state.json
# PORT=3000

# The Friday Weekly Check-in reminder was removed on 2026-09-15 at the CSM's
# request, so WEEKLY_REMINDER_ENABLED, WEEKLY_REMINDER_HOUR_ET,
# WEEKLY_REMINDER_MINUTE_ET, WEEKLY_CHECKIN_FORM_URL and DISCORD_TEST_CHANNEL_ID
# are no longer read by anything. Delete them from Railway when convenient.
# Nothing the bot runs now messages a client on a schedule.

# --- New-member onboarding (see README) ---
# Set to exactly "true" to actually create channels / send messages / write
# to Airtable on a real join. Also requires enabling the "Server Members" and
# "Message Content" Privileged Gateway Intents in the Discord Developer
# Portal (Bot tab), and the bot having standing "Manage Channels" in the
# client server.
# NEW_MEMBER_ONBOARDING_ENABLED=true
# DISCORD_CLIENT_GUILD_ID=
# DISCORD_CSM_ROLE_ID is no longer read - the staff in a client's private
# channel come from tiers.js by role name. Delete it from Railway when
# convenient; leaving it set does nothing.
# Defaults to DISCORD_OPS_NOTIFICATIONS_CHANNEL_ID if unset.
# DISCORD_ONBOARDING_FLAG_CHANNEL_ID=
# Defaults to a literal "[Insert Link]" placeholder in the welcome message if unset.
# NOTION_DASHBOARD_URL=

# --- Invite-link routing (see README) ---
# One invite per package, mapped to the roles it grants. Generate the invites
# and this exact line with:
#   node scripts/apply-discord-structure.js --apply --invites
# Format: code=slotKey,code=slotKey
# DISCORD_INVITE_ROLE_MAP=aBcD1234=coaches:momentum,eFgH5678=creators:foundations

# --- Tier sync: Discord role -> Airtable (see README) ---
# Set to exactly "true" to let a tier role change in Discord rewrite
# Package / Tier in Airtable, move the client's private channel to the new
# tier category, and log it. Leave off until the tier roles themselves are
# correct - this writes to a billing field. Requires the bot to have
# "Manage Roles" and "Manage Guild" in the client server.
# TIER_SYNC_ENABLED=true
# Defaults to DISCORD_OPS_NOTIFICATIONS_CHANNEL_ID if unset.
# DISCORD_TIER_CHANGES_CHANNEL_ID=

# --- Ops server notifications (see README) ---
# Where onboarding flags and the tier-change audit log go. This is a channel
# in the OPS server, not the client server - staff work there, clients are in
# the other one, and splitting bot output across both would mean watching two
# places. The bot must be a member of the ops server for these to send.
# Defaults to 1547339220840882306.
# DISCORD_OPS_NOTIFICATIONS_CHANNEL_ID=

# --- Weekly Check-in missing report (see README) ---
# Saturday's "who hasn't submitted" report, posted to a staff channel.
# Off by default like the other jobs; no client ever sees this one.
# WEEKLY_REPORT_ENABLED=true
# Defaults to DISCORD_WEEKLY_CHECKIN_CHANNEL_ID, so the "who submitted" feed
# and the "who didn't" report sit in the same place.
# DISCORD_WEEKLY_REPORT_CHANNEL_ID=
# Fires Saturday at this time, America/New_York (DST-aware). Default 12:00.
# WEEKLY_REPORT_HOUR_ET=12
# WEEKLY_REPORT_MINUTE_ET=0
# Days a new client is excused for. Default 0 - a new client checks in like
# everyone else, because their first one is the baseline their CSM reads.
# Raise it if the report gets noisy with new joiners; the excuse lapses on its
# own. At 0 it still excludes anyone whose Start Date is in the future.
# WEEKLY_REPORT_GRACE_DAYS=0

# --- Post Call reports (see README) ---
# Where a logged sales-call outcome posts. Unset means the automation is not
# registered at all - the channel id is the on/off switch.
# DISCORD_POST_CALL_CHANNEL_ID=
