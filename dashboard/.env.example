# --- Database (Railway Postgres) ---
DATABASE_URL=

# --- Auth (Google OAuth via Auth.js) ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI:
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Any random 32+ byte string: `openssl rand -base64 32`
AUTH_SECRET=
# The deployed origin, e.g. https://dashboard.thecalled.com
AUTH_URL=

# --- Calendly ---
# Personal Access Token: calendly.com -> Integrations -> API & Webhooks.
# Needs a paid plan (Standard/Teams/Enterprise) for webhooks to exist at all.
CALENDLY_PAT=
# The secret passed as `signing_key` when the webhook subscription was created.
# Every delivery is rejected without it - see src/lib/calendly.ts.
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Discord (notifications out of the dashboard) ---
# Reuses the existing automation-hub bot. Optional until notifications ship.
DISCORD_BOT_TOKEN=
DISCORD_SETTER_CHANNEL_ID=
